# ============================================
# Work Diary Docker 环境变量配置
# ============================================
# 使用方法: 复制此文件为 .env 并填写实际值
# cp .env.example .env
# ============================================

# -----------------
# 数据库配置
# -----------------
# MySQL root 密码（必填，建议使用强密码）
MYSQL_ROOT_PASSWORD=your_secure_password_here

# 数据库名称
MYSQL_DATABASE=work_diary_db

# -----------------
# AI 服务配置
# -----------------
# Groq API Key（必填，用于 AI 文本润色功能）
# 获取地址: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# -----------------
# 代理配置（可选）
# -----------------
# 如果需要通过代理访问外网 API，请取消注释并填写
# HTTPS_PROXY=http://192.168.1.1:7890
# HTTP_PROXY=http://192.168.1.1:7890

# -----------------
# 数据持久化路径
# -----------------
# 数据存储路径（可选，默认使用项目目录下的 ./data）
# 生产环境建议使用绝对路径，例如：
# MYSQL_DATA_PATH=/var/lib/work-diary/mysql
# REDIS_DATA_PATH=/var/lib/work-diary/redis

# 开发环境可使用相对路径（默认）：
MYSQL_DATA_PATH=./data/mysql
REDIS_DATA_PATH=./data/redis

# 如果要继续使用原来的路径，取消下面两行的注释：
# MYSQL_DATA_PATH=/home/pinna/my_prod_data/mysql_data
# REDIS_DATA_PATH=/home/pinna/my_prod_data/redis_data

# -----------------
# Flask 配置
# -----------------
# Flask 调试模式（0=关闭, 1=开启）
# 生产环境必须设置为 0
FLASK_DEBUG=0
